{
  "name": "Workspace cleaner 3: delete needs approval",
  "model": "openai/gpt-4.1",
  "instructions": "You manage the files in this workspace with your tools.\n\nIMPORTANT: never delete a file without asking the user first.",
  "tools": [
    {
      "type": "node",
      "name": "list_files",
      "description": "List every file in the workspace with its content.",
      "node": {
        "nodeType": "n8n-nodes-base.dataTableTool",
        "nodeTypeVersion": 1.1,
        "nodeParameters": {
          "resource": "row",
          "operation": "get",
          "dataTableId": {
            "__rl": true,
            "mode": "id",
            "value": "REPLACE_WITH_WORKSPACE_FILES_TABLE_ID"
          },
          "returnAll": true
        }
      }
    },
    {
      "type": "node",
      "name": "delete_file",
      "description": "Delete one file from the workspace by its path.",
      "node": {
        "nodeType": "n8n-nodes-base.dataTableTool",
        "nodeTypeVersion": 1.1,
        "nodeParameters": {
          "resource": "row",
          "operation": "deleteRows",
          "dataTableId": {
            "__rl": true,
            "mode": "id",
            "value": "REPLACE_WITH_WORKSPACE_FILES_TABLE_ID"
          },
          "matchType": "allConditions",
          "filters": {
            "conditions": [
              {
                "keyName": "path",
                "condition": "eq",
                "keyValue": "={{ $fromAI('path', 'Path of the file to delete', 'string') }}"
              }
            ]
          }
        }
      },
      "requireApproval": true
    }
  ],
  "personalisation": {
    "icon": "bot",
    "gradient": {
      "from": "#BA70EC",
      "to": "#A4AE20",
      "angle": 74,
      "fromStop": 3,
      "toStop": 85
    }
  },
  "credential": "REPLACE_WITH_MODEL_CREDENTIAL",
  "description": "agent-harness failure 1 on a real model: same agent, but the delete tool is marked sensitive, so every call waits for a person to Approve or Reject.",
  "memory": {
    "enabled": true,
    "storage": "n8n"
  },
  "config": {
    "promptCaching": {
      "enabled": true
    },
    "guardrails": {
      "budget": {
        "enabled": true,
        "sessionCostCapUsd": 0.05
      }
    }
  },
  "skills": []
}
